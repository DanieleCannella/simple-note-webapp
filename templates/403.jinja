{% extends "base.jinja" %}

{% block title %}Accesso Negato (403){% endblock %}
{% block body_class %}bg-light vh-100 d-flex align-items-center{% endblock %}

{% block content %}
<div class="row justify-content-center w-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 text-center p-4 p-md-5">
            <div class="card-body">
                <i class="bi bi-shield-lock-fill text-danger mb-3" style="font-size: 4rem;"></i>
                <h1 class="fw-bold text-dark display-4">403</h1>
                <h4 class="text-muted mb-4">Accesso Negato</h4>
                <p class="text-muted mb-4">
                    Non hai i permessi necessari per visualizzare questa pagina o eseguire questa azione. Se ritieni sia un errore, contatta l'amministratore.
                </p>
                <a href="{{ url_for('root') }}" class="btn btn-danger px-4 py-2 fw-bold">
                    <i class="bi bi-arrow-left me-2"></i>Torna indietro
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}