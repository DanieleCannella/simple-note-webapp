{% extends "base.jinja" %}

{% block title %}Le mie Note{% endblock %}

{% block content %}
<header class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <h1 class="fw-bold text-primary mb-0">Le mie Note</h1>
    <div>
         <span class="me-3 text-muted">Ciao, <strong>{{ session['username'] }}</strong></span>
        <a href="{{ url_for('logout') }}" class="btn btn-danger">Logout</a>
    </div>
</header>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="POST" action="{{ url_for('add_note') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
            <div class="mb-3">
                <input type="text" class="form-control" name="title" placeholder="Titolo..." required>
            </div>
            <div class="mb-3">
                <textarea class="form-control" name="body" rows="3" placeholder="Contenuto..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100">Aggiungi Nota</button>
        </form>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-3 rounded shadow-sm mb-4">
    <div class="mb-2 mb-md-0">
        <span class="fw-bold me-2 small text-muted text-uppercase">Ordina per:</span>
        <div class="btn-group" role="group">
            <a href="{{ url_for('index', sort='modified_asc' if current_sort == 'modified_desc' else 'modified_desc', page=current_page, all=show_all) }}" 
               class="btn btn-sm btn-outline-primary {% if 'modified' in current_sort %}active{% endif %}">
                Modifica 
                {% if current_sort == 'modified_asc' %}<i class="bi bi-caret-up-fill"></i>{% elif current_sort == 'modified_desc' %}<i class="bi bi-caret-down-fill"></i>{% endif %}
            </a>
            
            <a href="{{ url_for('index', sort='created_asc' if current_sort == 'created_desc' else 'created_desc', page=current_page, all=show_all) }}" 
               class="btn btn-sm btn-outline-primary {% if 'created' in current_sort %}active{% endif %}">
                Creazione
                {% if current_sort == 'created_asc' %}<i class="bi bi-caret-up-fill"></i>{% elif current_sort == 'created_desc' %}<i class="bi bi-caret-down-fill"></i>{% endif %}
            </a>
            
            <a href="{{ url_for('index', sort='title_desc' if current_sort == 'title_asc' else 'title_asc', page=current_page, all=show_all) }}" 
               class="btn btn-sm btn-outline-primary {% if 'title' in current_sort %}active{% endif %}">
                Titolo
                {% if current_sort == 'title_asc' %}<i class="bi bi-caret-up-fill"></i>{% elif current_sort == 'title_desc' %}<i class="bi bi-caret-down-fill"></i>{% endif %}
            </a>
        </div>
    </div>

    <div class="d-flex align-items-center">
        {% if show_all == 0 %}
            <div class="btn-group me-2" role="group">
                {% if total_pages > 0 %}
                    {% for p in range(1, total_pages + 1) %}
                        <a href="{{ url_for('index', page=p, sort=current_sort) }}" 
                           class="btn btn-sm btn-outline-secondary {% if current_page == p %}active{% endif %}">{{ p }}</a>
                    {% endfor %}
                {% else %}
                    <span class="btn btn-sm btn-outline-secondary disabled">1</span>
                {% endif %}
            </div>
        {% endif %}
        
        <a href="{{ url_for('index', all=1 if show_all == 0 else 0, sort=current_sort) }}" 
           class="btn btn-sm {% if show_all == 1 %}btn-primary active{% else %}btn-outline-primary{% endif %}">
            Vedi tutte
        </a>
    </div>
</div>

<main>
    <div class="row g-3">
        {% for note in notes %}
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm note-card">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">{{ note.title }}</h5>
                    <div class="mb-3 text-muted" style="font-size: 0.75rem;">
                        <div><i class="bi bi-calendar-plus"></i> Creata: {{ note.created }}</div>
                        <div><i class="bi bi-pencil-square"></i> Modificata: {{ note.last_modified }}</div>
                    </div>
                    <p class="card-text flex-grow-1">{{ note.body | truncate(500) }}</p>
                    <div class="mt-auto d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#readNoteModal" data-note-title="{{ note.title }}" data-note-body="{{ note.body }}">Leggi</button>
                        <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#editNoteModal" data-note-id="{{ note.id }}" data-note-title="{{ note.title }}" data-note-body="{{ note.body }}">Modifica</button>
                        <form action="{{ url_for('delete_note', note_id=note.id) }}" method="POST" class="ms-auto" onsubmit="return confirm('Eliminare?');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
                            <button type="submit" class="btn btn-danger btn-sm">Elimina</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <p class="text-center text-muted fst-italic mt-4">Nessuna nota da mostrare in questa vista.</p>
        </div>
        {% endfor %}
    </div>
</main>

<div class="modal fade" id="readNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="read-modal-title">Titolo Nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea class="form-control bg-white" id="read-modal-body" rows="10" readonly style="resize: vertical;"></textarea>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="edit-note-form" method="POST">
                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}"/>
                <div class="modal-header border-0 bg-light">
                    <h5 class="modal-title fw-bold">Modifica Nota</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <input type="text" class="form-control fw-bold" id="edit-modal-title" name="title" required>
                    </div>
                    <div>
                       <textarea class="form-control" id="edit-modal-body" name="body" rows="8" required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-primary">Salva Modifiche</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const readNoteModal = document.getElementById('readNoteModal');
    if(readNoteModal) {
        readNoteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const title = button.getAttribute('data-note-title');
            const body = button.getAttribute('data-note-body');

            readNoteModal.querySelector('#read-modal-title').textContent = title;
            readNoteModal.querySelector('#read-modal-body').value = body;
        });
    }

    const editNoteModal = document.getElementById('editNoteModal');
    if(editNoteModal) {
        editNoteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-note-id');
            const title = button.getAttribute('data-note-title');
            const body = button.getAttribute('data-note-body');
            editNoteModal.querySelector('#edit-modal-title').value = title;
            editNoteModal.querySelector('#edit-modal-body').value = body;
            const form = editNoteModal.querySelector('#edit-note-form');
            form.action = "{{ url_for('update_note', note_id=0) }}".replace('/0', '/' + id);
        });
    }
});
</script>
{% endblock %}