{% extends "base.jinja" %}

{% block title %}Errore di Sistema (500){% endblock %}
{% block body_class %}bg-light vh-100 d-flex align-items-center{% endblock %}

{% block content %}
<div class="row justify-content-center w-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 text-center p-4 p-md-5">
            <div class="card-body">
                <i class="bi bi-tools text-secondary mb-3" style="font-size: 4rem;"></i>
                <h1 class="fw-bold text-dark display-4">500</h1>
                <h4 class="text-muted mb-4">Errore Interno</h4>
                <p class="text-muted mb-4">
                    Ops! Qualcosa è andato storto sui nostri server. Abbiamo registrato il problema e i nostri tecnici sono già al lavoro per risolverlo.
                </p>
                <a href="{{ url_for('root') }}" class="btn btn-secondary px-4 py-2 fw-bold">
                    <i class="bi bi-arrow-clockwise me-2"></i>Riprova più tardi
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}