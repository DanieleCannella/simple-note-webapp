{% extends "base.jinja" %}

{% block title %}Pagina Non Trovata (404){% endblock %}
{% block body_class %}bg-light vh-100 d-flex align-items-center{% endblock %}

{% block content %}
<div class="row justify-content-center w-100">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 text-center p-4 p-md-5">
            <div class="card-body">
                <i class="bi bi-search text-warning mb-3" style="font-size: 4rem;"></i>
                <h1 class="fw-bold text-dark display-4">404</h1>
                <h4 class="text-muted mb-4">Pagina non trovata</h4>
                <p class="text-muted mb-4">
                    Oops! La risorsa che stai cercando non esiste, è stata rinominata oppure è stata eliminata.
                </p>
                <a href="{{ url_for('root') }}" class="btn btn-primary px-4 py-2 fw-bold">
                    <i class="bi bi-house-door me-2"></i>Torna alla Home
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}